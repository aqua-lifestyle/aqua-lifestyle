# ABP host base URL (no trailing slash). Must match backend Kestrel binding.
# Prefer HTTPS once the ASP.NET development certificate is trusted:
#   dotnet dev-certs https --trust
#   then open https://localhost:44311/swagger and accept the cert in the browser.
# Linux HTTP fallback when the cert cannot be trusted system-wide:
#   NEXT_PUBLIC_ABP_API_URL=http://localhost:21021
NEXT_PUBLIC_ABP_API_URL=https://localhost:44311
NEXTAUTH_SECRET=replace_with_a_32_character_minimum_secret
NEXTAUTH_URL=http://localhost:3000
