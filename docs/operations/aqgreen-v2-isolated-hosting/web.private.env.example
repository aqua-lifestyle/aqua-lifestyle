NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0
PORT=3000
NEXTAUTH_SECRET=<fresh-isolated-session-secret-at-least-32-characters>
# These public values must also match the production build inputs.
NEXT_PUBLIC_ABP_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_DEFAULT_TENANT_NAME=Default
NEXT_PUBLIC_MONITORING_ENDPOINT=
