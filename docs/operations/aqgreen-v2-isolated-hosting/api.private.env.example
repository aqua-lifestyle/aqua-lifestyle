# EXAMPLE ONLY. Generate fresh isolated secrets outside the repository.
ASPNETCORE_ENVIRONMENT=AQGreenV2Demo
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=aqua_aqgreen_v2_demo;Username=postgres;Password=<fresh-demo-db-secret>
DATABASE_URL=
AQGreenV2Demo__Enabled=true
AQGreenV2Demo__Fixture__Enabled=true
AQGreenV2Demo__Fixture__MemberPassword=<fresh-demo-member-password-at-least-16-characters>
AQUA_INITIAL_ADMIN_PASSWORD=<fresh-demo-admin-password-at-least-16-characters>
# Matches carried-forward seeding profile. Only disposable synthetic data allowed.
AQUA_SEED_DEMO_DATA=true
App__ServerRootAddress=http://127.0.0.1:8080/
App__ClientRootAddress=http://127.0.0.1:3000/
App__CorsOrigins=http://127.0.0.1:3000
App__DefaultTenantName=Default
Authentication__JwtBearer__IsEnabled=true
Authentication__JwtBearer__SecurityKey=<fresh-isolated-jwt-key>
Authentication__JwtBearer__Issuer=AqualLifeStyle
Authentication__JwtBearer__Audience=AqualLifeStyle
Redis__Configuration=
Yoco__Mode=
Yoco__SecretKey=
Yoco__WebhookSecret=
Bird__Enabled=false
Bird__ApiKey=
Bird__FromEmail=
Bird__FromName=Aqua Lifestyle Club isolated test
Bird__ReplyToEmail=
App__WeeklyCommissions__Enabled=false
App__WeeklyCommissions__RecoveryVerified=false
App__WeeklyCommissions__ObservabilityReady=false
App__EntryMonthlyObligations__Enabled=false
