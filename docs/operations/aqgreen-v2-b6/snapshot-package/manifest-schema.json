{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqua:aqgreen:b6:snapshot-manifest:v4",
  "title": "AQGreen B6 base snapshot or final analysis manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestStage", "snapshotId", "analysisSnapshotCutoff", "createdAt", "sourceObservedAt", "sourcePostgreSqlMajorVersion", "sourcePostgreSqlVersion", "sourceServerEncoding", "sourceDatabaseCollation", "sourceExtensions", "sourceSystemIdentifier", "repositoryCommit", "exportToolVersion", "sourceSchemaVersion", "efMigrationHead", "sourceMvccSnapshotEvidence", "sourceDatabaseIdentityEvidence", "transactionMode", "authorizedTenantSnapshotKey", "populationScope", "allowlistVersion", "allowlistDigest", "sanitisationSchemeVersion", "orderingComparatorVersion", "pseudonymisationSchemeVersion", "inventoryRulesVersion", "analysisAdapterVersion", "simulatorVersion", "packageSchemaVersion", "canonicalEncodingVersion", "toolchainIdentity", "tables", "relationshipDigest", "recruiterCorrectionDigest", "candidatePopulationDigest", "overallSnapshotDigest", "digestAlgorithm", "manifestHash"],
  "properties": {
    "manifestStage": {"enum": ["BASE_SNAPSHOT", "FINAL_ANALYSIS"]},
    "snapshotId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "analysisSnapshotCutoff": {"type": "string", "format": "date-time"},
    "createdAt": {"type": "string", "format": "date-time"},
    "sourceObservedAt": {"type": "string", "format": "date-time"},
    "sourcePostgreSqlMajorVersion": {"const": 18},
    "sourcePostgreSqlVersion": {"type": "string", "pattern": "^18\\.4( |$)"},
    "sourceServerEncoding": {"const": "UTF8"},
    "sourceDatabaseCollation": {"type": "string", "minLength": 1},
    "sourceExtensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sourceSystemIdentifier": {"type": "string", "pattern": "^[A-Za-z0-9._:+/@-]{1,128}$"},
    "repositoryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "exportToolVersion": {"const": "AQGreenB6SnapshotPackageV4"},
    "sourceSchemaVersion": {"$ref": "#/$defs/digest"},
    "efMigrationHead": {"const": "20261005194901_AddIsolatedAQGreenPilotEvidence"},
    "sourceMvccSnapshotEvidence": {"$ref": "#/$defs/digest"},
    "sourceDatabaseIdentityEvidence": {"$ref": "#/$defs/digest"},
    "transactionMode": {"const": "REPEATABLE READ READ ONLY"},
    "authorizedTenantSnapshotKey": {"type": "integer", "minimum": 1},
    "populationScope": {"const": "ALL_TENANT_AQGREEN_PARTICIPATIONS"},
    "allowlistVersion": {"const": "AQGreenB6SnapshotAllowlistV2"},
    "allowlistDigest": {"$ref": "#/$defs/digest"},
    "sanitisationSchemeVersion": {"const": "AQGreenB6SanitisationV3"},
    "orderingComparatorVersion": {"const": "DotNetGuidCompareToOrdinalV3"},
    "pseudonymisationSchemeVersion": {"const": "HmacSha256NamespacedFatalCollisionV3"},
    "inventoryRulesVersion": {"const": "AQGreenLegacyInventoryV2"},
    "analysisAdapterVersion": {"const": "AQGreenB6RepresentativeAnalysisV3"},
    "simulatorVersion": {"const": "AQGreenLegacyCanonicalisationSimulationV2"},
    "packageSchemaVersion": {"const": "AQGreenB6SnapshotPackageV4"},
    "canonicalEncodingVersion": {"const": "B6CanonicalLengthPrefixedUtf8V1"},
    "digestAlgorithm": {"const": "SHA-256"},
    "toolchainIdentity": {"$ref": "#/$defs/toolchainIdentity"},
    "tables": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["table", "rowCount", "canonicalDigest", "schemaContractDigest"], "properties": {"table": {"type": "string"}, "rowCount": {"type": "integer", "minimum": 0}, "canonicalDigest": {"$ref": "#/$defs/digest"}, "schemaContractDigest": {"$ref": "#/$defs/digest"}}}},
    "relationshipDigest": {"$ref": "#/$defs/digest"},
    "recruiterCorrectionDigest": {"$ref": "#/$defs/digest"},
    "candidatePopulationDigest": {"$ref": "#/$defs/digest"},
    "overallSnapshotDigest": {"$ref": "#/$defs/digest"},
    "manifestHash": {"$ref": "#/$defs/digest"},
    "baseManifestHash": {"$ref": "#/$defs/digest"},
    "analysisDigests": {"type": "object", "additionalProperties": false, "required": ["rootDispositionDigest", "canonicalisationPopulationDigest", "qualificationEligibilityDigest", "historicalImpactInventoryDigest", "acceptedComponentDigest", "quarantinedComponentDigest", "analysisArtifactDigest", "simulatorInputDigest", "simulatorOutputDigest", "simulationArtifactDigest", "impactReportDigest", "inventoryDigest", "inventoryResultDigest", "inventorySemanticDigest", "inventoryQueryDigest", "toolchainDigest"], "properties": {"rootDispositionDigest": {"$ref": "#/$defs/digest"}, "canonicalisationPopulationDigest": {"$ref": "#/$defs/digest"}, "qualificationEligibilityDigest": {"$ref": "#/$defs/digest"}, "historicalImpactInventoryDigest": {"$ref": "#/$defs/digest"}, "acceptedComponentDigest": {"$ref": "#/$defs/digest"}, "quarantinedComponentDigest": {"$ref": "#/$defs/digest"}, "analysisArtifactDigest": {"$ref": "#/$defs/digest"}, "simulatorInputDigest": {"$ref": "#/$defs/digest"}, "simulatorOutputDigest": {"$ref": "#/$defs/digest"}, "simulationArtifactDigest": {"$ref": "#/$defs/digest"}, "impactReportDigest": {"$ref": "#/$defs/digest"}, "inventoryDigest": {"$ref": "#/$defs/digest"}, "inventoryResultDigest": {"$ref": "#/$defs/digest"}, "inventorySemanticDigest": {"$ref": "#/$defs/digest"}, "inventoryQueryDigest": {"$ref": "#/$defs/digest"}, "toolchainDigest": {"$ref": "#/$defs/digest"}}}
  },
  "allOf": [
    {"if": {"properties": {"manifestStage": {"const": "BASE_SNAPSHOT"}}}, "then": {"not": {"anyOf": [{"required": ["baseManifestHash"]}, {"required": ["analysisDigests"]}]}}},
    {"if": {"properties": {"manifestStage": {"const": "FINAL_ANALYSIS"}}}, "then": {"required": ["baseManifestHash", "analysisDigests"]}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assemblyIdentity": {"type": "object", "additionalProperties": false, "required": ["assemblyName", "assemblySha256", "informationalVersion"], "properties": {"assemblyName": {"type": "string", "minLength": 1}, "assemblySha256": {"$ref": "#/$defs/digest"}, "informationalVersion": {"type": ["string", "null"]}}},
    "toolchainIdentity": {"type": "object", "additionalProperties": false, "required": ["repositoryCommit", "evidenceClassification", "runner", "firstPartyDependencies"], "properties": {"repositoryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "evidenceClassification": {"enum": ["PRECOMMIT_SYNTHETIC_VALIDATION", "OPERATIONAL_EVIDENCE"]}, "runner": {"$ref": "#/$defs/assemblyIdentity"}, "firstPartyDependencies": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/assemblyIdentity"}}}}
  }
}
