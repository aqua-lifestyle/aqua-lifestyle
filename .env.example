# Copy to .env for local Docker Compose only. Never commit the populated .env file.

POSTGRES_DB=aqualifestyle
POSTGRES_USER=aqualifestyle
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECURITY_KEY=replace_with_a_long_random_jwt_signing_key
JWT_ISSUER=AqualLifeStyle
JWT_AUDIENCE=AqualLifeStyle

DEFAULT_AREA_NAME=Default
NEXT_PUBLIC_ABP_API_URL=http://localhost:21021
NEXT_PUBLIC_MONITORING_ENDPOINT=
NEXT_PUBLIC_SELF_REGISTRATION_ENABLED=false

# Required only when a production database is bootstrapped. Use a unique value
# with at least 16 characters, uppercase, lowercase, number, and special character.
AQUA_INITIAL_ADMIN_PASSWORD=replace_with_a_unique_one_time_admin_password

# Yoco Checkout API values. Keep both secrets on the API only. Register the
# webhook at https://your-api.example/api/payments/yoco/webhook and save the
# one-time whsec_ value returned by Yoco.
YOCO_SECRET_KEY=replace_with_yoco_test_or_live_secret_key
YOCO_WEBHOOK_SECRET=replace_with_yoco_webhook_secret
YOCO_MODE=test

# Server-only frontend secret. Generate at least 32 random bytes.
NEXTAUTH_SECRET=replace_with_a_long_random_frontend_session_secret
