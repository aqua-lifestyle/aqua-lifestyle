# Copy to .env for local Docker Compose only. Never commit the populated .env file.

POSTGRES_DB=aqualifestyle
POSTGRES_USER=aqualifestyle
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECURITY_KEY=replace_with_a_long_random_jwt_signing_key
JWT_ISSUER=AqualLifeStyle
JWT_AUDIENCE=AqualLifeStyle

# Base64-encoded PKCS#12 certificate and its password. Keep both server-only.
# Retain the certificate while any Data Protection key encrypted by it exists.
DATA_PROTECTION_CERTIFICATE_BASE64=replace_with_base64_encoded_pkcs12_certificate
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace_with_a_long_random_certificate_password
DATA_PROTECTION_PREVIOUS_CERTIFICATE_BASE64=
DATA_PROTECTION_PREVIOUS_CERTIFICATE_PASSWORD=

DEFAULT_AREA_NAME=Default
NEXT_PUBLIC_ABP_API_URL=http://localhost:21021
NEXT_PUBLIC_MONITORING_ENDPOINT=
NEXT_PUBLIC_SELF_REGISTRATION_ENABLED=false

# Required only when a production database is bootstrapped. Use a unique value
# with at least 16 characters, uppercase, lowercase, number, and special character.
AQUA_INITIAL_ADMIN_PASSWORD=replace_with_a_unique_one_time_admin_password

# Yoco Checkout API values. Keep both secrets on the API only. The webhook
# secret may be blank only in test mode; the API then rejects every webhook and
# cannot confirm payments. Live mode always requires it.
# Register the webhook at https://your-api.example/api/payments/yoco/webhook and
# save the one-time whsec_ value returned by Yoco.
YOCO_SECRET_KEY=replace_with_yoco_test_or_live_secret_key
YOCO_WEBHOOK_SECRET=
YOCO_MODE=test

# Non-sensitive deployment identifiers exposed by health/operations diagnostics.
# Use a commit SHA or immutable build ID, never a credential or customer value.
DEPLOYMENT_BUILD_ID=local-compose
DEPLOYMENT_IMAGE_ID=
DEPLOYMENT_ENVIRONMENT_ID=local-disposable

# Bird transactional email. The API key is server-only. From email must use
# a sending domain verified in Bird.
BIRD_ENABLED=false
BIRD_API_KEY=
BIRD_FROM_EMAIL=
BIRD_FROM_NAME=Aqua Lifestyle Club
BIRD_REPLY_TO_EMAIL=

# Server-only frontend secret. Generate at least 32 random bytes.
NEXTAUTH_SECRET=replace_with_a_long_random_frontend_session_secret
